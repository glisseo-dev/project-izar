<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.glisseo.izar</groupId>
    <artifactId>izar-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>izar-compiler</artifactId>
  <name>Izar :: Compiler</name>
  <description>Build-time generation of Java models, operation metadata, and executable
    documents from a supplied schema and unchanged GraphQL operation files. Independent of
    any build tool.</description>

  <dependencies>
    <dependency>
      <groupId>dev.glisseo.izar</groupId>
      <artifactId>izar-operation</artifactId>
    </dependency>
    <!-- Operation IDs and manifest bodies derive from the final executable document, so the
         compiler writes manifests through the same code the server and controller read. -->
    <dependency>
      <groupId>dev.glisseo.izar</groupId>
      <artifactId>izar-manifest</artifactId>
    </dependency>

    <!-- Parsing, schema handling, and operation validation. Izar does not reimplement the
         GraphQL parser. Version 25.0 comes from the Boot BOM, matching the server baseline. -->
    <dependency>
      <groupId>com.graphql-java</groupId>
      <artifactId>graphql-java</artifactId>
    </dependency>

    <!-- Test-only: exercises the optional common scalar adapters as a real, generated-code
         codec dependency, alongside a fixture codec with no dependency on this module at all. -->
    <dependency>
      <groupId>dev.glisseo.izar</groupId>
      <artifactId>izar-scalars</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
