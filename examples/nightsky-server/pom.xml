<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Deliberately NOT a child of izar-parent (see ../README.md): this project is a real,
       standalone GraphQL server, resolving izar-server as an installed artifact the same way
       nightsky-sync-client/nightsky-reactive-client resolve izar-client. Its own ordinary Spring
       Boot parent keeps it independently buildable and runnable. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>dev.glisseo.izar.examples</groupId>
  <artifactId>nightsky-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <name>Izar example :: Nightsky server</name>
  <description>Issue 20: a standalone Spring GraphQL server serving the Nightsky stargazing
    schema, the target the nightsky-sync-client and nightsky-reactive-client examples run
    against. Issue 23: enforces an allowlist, via izar-server, built from what both clients
    actually send.
  </description>

  <properties>
    <java.version>25</java.version>
    <izar.version>0.1.0-SNAPSHOT</izar.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-graphql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>dev.glisseo.izar</groupId>
      <artifactId>izar-server</artifactId>
      <version>${izar.version}</version>
    </dependency>

    <dependency>
      <groupId>com.graphql-java</groupId>
      <artifactId>graphql-java-extended-scalars</artifactId>
      <version>24.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
