<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- A standalone consumer: install Izar at the repository root before building this project. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>dev.glisseo.izar.examples</groupId>
  <artifactId>nightsky-jackson-client</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Izar example :: Nightsky Jackson client</name>
  <description>A Nightsky client that maps Jackson-mode generated models with Spring GraphQL toEntity.</description>

  <properties>
    <java.version>25</java.version>
    <izar.version>0.1.0-SNAPSHOT</izar.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.glisseo.izar</groupId>
      <artifactId>izar-operation</artifactId>
      <version>${izar.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-graphql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>dev.glisseo.izar</groupId>
        <artifactId>izar-maven-plugin</artifactId>
        <version>${izar.version}</version>
        <executions>
          <execution>
            <id>generate-jackson-sources</id>
            <goals><goal>generate</goal></goals>
          </execution>
        </executions>
        <configuration>
          <basePackage>dev.glisseo.izar.examples.nightsky.jackson.generated</basePackage>
          <generationMode>JACKSON</generationMode>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution><goals><goal>repackage</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
