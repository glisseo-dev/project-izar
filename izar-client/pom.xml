<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.glisseo.izar</groupId>
    <artifactId>izar-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>izar-client</artifactId>
  <name>Izar :: Spring client</name>
  <description>Connects generated operations to application-configured Spring GraphQL clients.
    Synchronous and reactive adapters share models, metadata, and serialization behavior.
    Spring owns HTTP execution, authentication, filters, and instrumentation.</description>

  <dependencies>
    <dependency>
      <groupId>dev.glisseo.izar</groupId>
      <artifactId>izar-operation</artifactId>
    </dependency>

    <!-- Persisted-ID execution derives a request's sha256Hash the same way manifest generation
         derives a manifest entry's id, so both agree on operation identity. -->
    <dependency>
      <groupId>dev.glisseo.izar</groupId>
      <artifactId>izar-manifest</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.graphql</groupId>
      <artifactId>spring-graphql</artifactId>
    </dependency>

    <!-- GraphQlClient's reactive execute() already returns Mono; declared explicitly here
         because ReactiveGraphQlOperations's public API surfaces Mono directly, rather than
         relying on it arriving transitively through spring-graphql. -->
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
    </dependency>

    <!-- PersistedIdGraphQlClient accepts application-configured RestClient/WebClient instances.
         Keep the synchronous stack required and the reactive stack optional so a synchronous-only
         consumer does not acquire WebClient. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webflux</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test-only: the persisted-ID factory tests execute against a real HTTP fixture, which
         needs a JSON HttpMessageConverter. A consuming application supplies this through its
         Spring web dependencies. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
