<?xml version="1.0" encoding="UTF-8" standalone="no"?><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.glisseo.izar</groupId>
  <artifactId>izar-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>Izar</name>
  <description>GraphQL operations for Spring: operation-first Java generation, Spring client
    execution, manifest distribution, and server-side allowlisting.</description>
  <url>https://github.com/glisseo-dev/project-izar</url>
  <organization>
    <name>Glisseo</name>
  </organization>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/glisseo-dev/project-izar.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/glisseo-dev/project-izar.git</developerConnection>
    <url>https://github.com/glisseo-dev/project-izar</url>
  </scm>
  <developers>
    <developer>
      <id>glisseo-dev</id>
      <name>Glisseo</name>
      <url>https://github.com/glisseo-dev</url>
    </developer>
  </developers>

  <modules>
    <module>izar-operation</module>
    <module>izar-compiler</module>
    <module>izar-maven-plugin</module>
    <module>izar-client</module>
    <module>izar-scalars</module>
    <module>izar-manifest</module>
  </modules>

  <properties>
    <!-- Development version. A release overrides it from the tag with -Drevision=1.0.0-RC1, so
         releasing commits no version change. flatten-maven-plugin writes the resolved value into
         installed and deployed POMs. -->
    <revision>0.1.0-SNAPSHOT</revision>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Baseline from docs/technology-baseline.md, verified 2026-09-15. -->
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <maven.version>3.9.16</maven.version>
    <spring-boot.version>4.1.1</spring-boot.version>
    <spring-shell.version>4.0.3</spring-shell.version>
    <tomcat.version>11.0.26</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>

    <!-- Maven plugin development, used by izar-maven-plugin. -->
    <maven-plugin-api.version>3.9.16</maven-plugin-api.version>
    <maven-plugin-annotations.version>3.16.0</maven-plugin-annotations.version>
    <!-- The exact resolver version this project's ${maven.version} distribution bundles, so
         izar-maven-plugin's compile-time API matches what a real Maven run injects. -->
    <maven-resolver.version>1.9.27</maven-resolver.version>

    <!-- Build plugins, pinned for reproducibility. -->
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-plugin-plugin.version>3.16.0</maven-plugin-plugin.version>
    <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
    <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>

    <!-- Release profile: what Maven Central requires. -->
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>

    <!-- Frontend build toolchain. Exact package versions live in the frontend lockfile. -->
    <node.version>v24.21.0</node.version>
    <npm.version>11.19.0</npm.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot 4.1.1 (the latest GA; nothing newer fixes this yet) still manages
           Tomcat 11.0.24, which is affected by CVE-2026-68525, CVE-2026-65905, and
           CVE-2026-65182 (GHSA dependabot alerts 5-10). spring-boot-dependencies is
           imported via <scope>import</scope> rather than inherited as a <parent>, so
           overriding ${tomcat.version} alone does not reach placeholders already resolved
           inside that imported BOM; these entries, declared ahead of the import below, are
           the documented workaround. Drop them once spring-boot.version moves to a release
           that manages Tomcat >= 11.0.25. -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${tomcat.version}</version>
      </dependency>

      <!-- Spring Boot 4.1.1 still manages Jackson 3.1.5 and 2.21.5, which are affected by
           advisories fixed in 3.1.7 and 2.21.7 (Dependabot alerts on jackson-core and
           jackson-databind). Same mechanism as Tomcat above: BOM imports declared ahead of the
           Boot import win. Drop them once spring-boot.version moves to a release that manages
           Jackson >= 3.1.7 and 2.21.7. -->
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-2-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- The consuming Boot BOM owns managed framework versions: Spring Framework,
           Spring for GraphQL, GraphQL Java, Jackson, Reactor, JSpecify, JUnit, AssertJ.
           Izar does not force independently selected versions on top of it. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>dev.glisseo.izar</groupId>
        <artifactId>izar-operation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.glisseo.izar</groupId>
        <artifactId>izar-compiler</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.glisseo.izar</groupId>
        <artifactId>izar-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.glisseo.izar</groupId>
        <artifactId>izar-scalars</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.glisseo.izar</groupId>
        <artifactId>izar-manifest</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Every module states its nullability contract with JSpecify. -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all,-serial,-processing</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-plugin-plugin</artifactId>
          <version>${maven-plugin-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>com.github.eirslett</groupId>
          <artifactId>frontend-maven-plugin</artifactId>
          <version>${frontend-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Maven Central release: ./mvnw -Prelease -Drevision=<version> deploy. Signs with the GPG key
         from the environment and uploads one bundle for review in the Central Portal. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <configuration>
              <!-- Some {@link} targets resolve only in a full build, so doclint would fail the
                   release on references that javac accepts. -->
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Review the validated deployment in the Portal, then publish it by hand. -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
